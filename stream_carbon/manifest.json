{
    "manifest_version": 3,
    "name": "Streaming CO2 Tracker",
    "version": "1.0",
    "description": "Shows the estimated CO2 footprint of videos you watch.",
    "permissions": ["activeTab", "scripting"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
      }
    },
    "content_scripts": [
      {
        "matches": ["*://*.youtube.com/*"],
        "js": ["content.js"],
        "run_at": "document_end"
      }
    ]
  }
  